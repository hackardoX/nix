# Test-only sops: every secret of the real host (NixOS and Home Manager) is
# re-pointed at a sops file that mockSops encrypts at build time from the plain
# mock files in ./mock. There is one mock file per production sopsFile: the path
# below secrets/ with "/" replaced by "-" (secrets/homelab/services.yaml becomes
# mock/homelab-services.yaml). Only sopsFile is overridden; owner, group, mode,
# path and restartUnits keep their production values. The repository secrets
# files are never read.
#
# The throwaway age key is generated by mockSops. Activation copies it to the
# production keyFile (sops.age.keyFile, unchanged) and to the persistent copy of
# that path, which is what impermanence bind-mounts there after activation.
#
# The check `homelab/sops-mock` (vm-test.nix) keeps the plain mock files in step
# with the host. mockSops decrypts its own output and compares it with the input.
{
  lib,
  pkgs,
  host,
}:
let
  hmSecrets = lib.concatMap (u: lib.attrValues u.sops.secrets) (
    lib.attrValues (lib.filterAttrs (_: h: h ? sops) host.home-manager.users)
  );
  allSecrets = lib.attrValues host.sops.secrets ++ hmSecrets;

  mockNameOf =
    file:
    let
      m = builtins.match ".*/secrets/(.+)" (toString file);
    in
    if m == null then
      throw "vm-test: sopsFile is not under secrets/: ${toString file}"
    else
      lib.replaceStrings [ "/" ] [ "-" ] (lib.removeSuffix ".yaml" (lib.head m));

  # Mock file name -> { whole, keys }. whole: a whole-file secret (key = "");
  # otherwise keys are the nested key paths (a/b) the host reads from that file.
  groups = lib.mapAttrs (
    name: secrets:
    let
      keys = lib.unique (map (s: s.key) secrets);
    in
    lib.throwIf (lib.elem "" keys && keys != [ "" ])
      "vm-test: ${name} mixes whole-file and nested secrets"
      {
        whole = keys == [ "" ];
        keys = lib.sort lib.lessThan (lib.filter (k: k != "") keys);
      }
  ) (lib.groupBy (s: mockNameOf s.sopsFile) allSecrets);

  mockDir = ./mock;

  mockSops = pkgs.stdenvNoCC.mkDerivation {
    name = "homelab-vm-mock-sops";
    dontUnpack = true;
    dontConfigure = true;
    nativeBuildInputs = [
      pkgs.age
      pkgs.jq
      pkgs.openssh
      pkgs.openssl
      pkgs.sops
      pkgs.yq-go
    ];
    doCheck = true;

    buildPhase = ''
      runHook preBuild
      set -euo pipefail
      mkdir plain enc

      # Throwaway key, fresh on every build; never leaves the build directory
      # except as $out/age-key.txt.
      age-keygen -o age-key.txt 2>/dev/null
      recipient=$(age-keygen -y age-key.txt)

      # Generated material. Plain files hold a placeholder for each of these.
      openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwks.pem
      openssl pkey -in jwks.pem -check -noout
      ssh-keygen -q -t ed25519 -N "" -C homelab-vm-mock -f beszel_ed25519

      for name in ${lib.escapeShellArgs (lib.attrNames groups)}; do
        install -m 0644 ${mockDir}/$name.yaml plain/$name.yaml
      done
      yq -i '.authelia.jwks_key = load_str("jwks.pem")
        | .beszel.ssh_private_key = load_str("beszel_ed25519")
        | .beszel.ssh_public_key = load_str("beszel_ed25519.pub")' plain/homelab-services.yaml

      for f in plain/*.yaml; do
        sops --encrypt --age "$recipient" --input-type yaml --output-type yaml \
          --config /dev/null "$f" > "enc/$(basename "$f")"
      done
      runHook postBuild
    '';

    # Every encrypted file must decrypt with the generated key to exactly the
    # plain input (after sorting keys, so only content is compared).
    checkPhase = ''
      runHook preCheck
      set -euo pipefail
      for f in plain/*.yaml; do
        n=$(basename "$f")
        yq -o json "$f" | jq -S . > want.json
        SOPS_AGE_KEY_FILE=age-key.txt sops --decrypt --output-type json "enc/$n" | jq -S . > have.json
        if ! cmp -s want.json have.json; then
          echo "$n: the encrypted mock does not decrypt to its plain input" >&2
          exit 1
        fi
      done
      runHook postCheck
    '';

    installPhase = ''
      runHook preInstall
      mkdir -p $out
      cp enc/*.yaml $out/
      cp age-key.txt $out/age-key.txt
      runHook postInstall
    '';
  };

  mockFile = file: "${mockSops}/${mockNameOf file}.yaml";

  overrideSecrets =
    secrets: lib.mapAttrs (_: s: { sopsFile = lib.mkForce (mockFile s.sopsFile); }) secrets;

  keyFile = host.sops.age.keyFile;
  # impermanence keeps /var/lib/sops on the persistent volume and bind-mounts it
  # after activation; the copy under persistPath is what that mount shows.
  persistedKeyFile = "${host.boot.initrd.impermanence.persistPath}${keyFile}";
in
{
  inherit groups mockDir mockSops;

  module = {
    sops = {
      defaultSopsFile = lib.mkForce (mockFile host.sops.defaultSopsFile);
      validateSopsFiles = false;
      age.sshKeyPaths = lib.mkForce [ ];
      gnupg.sshKeyPaths = lib.mkForce [ ];
      secrets = overrideSecrets host.sops.secrets;
    };

    # Both sops steps read the key: setupSecretsForUsers (neededForUsers) and
    # setupSecrets. Both run after the key is placed.
    system.activationScripts = {
      homelabVmSopsKey = lib.stringAfter [ "specialfs" ] ''
        install -D -m 0600 ${mockSops}/age-key.txt ${keyFile}
        install -D -m 0600 ${mockSops}/age-key.txt ${persistedKeyFile}
      '';
      setupSecretsForUsers.deps = [ "homelabVmSopsKey" ];
      setupSecrets.deps = [ "homelabVmSopsKey" ];
    };

    home-manager.users = lib.mapAttrs (_: h: {
      sops = {
        validateSopsFiles = false;
        secrets = overrideSecrets h.sops.secrets;
      };
    }) (lib.filterAttrs (_: h: h ? sops) host.home-manager.users);
  };
}
